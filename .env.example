POSTGRES_DB=restaurant_delivery
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=restaurant
DATABASE_URL=postgres://restaurant:restaurant@postgres:5432/restaurant_delivery?sslmode=disable
PLATFORM_HTTP_ADDR=:8080
DEMO_HTTP_ADDR=:8081
PLATFORM_BASE_URL=http://platform-api:8080
DEMO_API_KEY=demo-secret
DEMO_PARTNER_API_KEYS=22222222-2222-2222-2222-222222222222=pasta-secret,33333333-3333-3333-3333-333333333333=sushi-secret
JWT_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-password
APP_ENVIRONMENT=local
APP_VERSION=dev
# Leave empty without the observability stack; the Compose override sets this automatically.
OTEL_EXPORTER_OTLP_ENDPOINT=
CLICKHOUSE_URL=
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=replace-with-a-local-password
EVENT_CLEANUP_INTERVAL=1h
PROCESSED_EVENT_RETENTION=168h
DEAD_LETTER_RETENTION=720h
EVENT_CLEANUP_BATCH_SIZE=1000

