{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://restaurant-delivery.local/events/order-created-v1.schema.json",
  "title": "order.created v1",
  "type": "object",
  "required": ["id", "userId", "restaurantId", "items", "deliveryFeeMinor", "totalMinor", "currency", "status", "version", "deliveryAddress", "createdAt"],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "userId": {"type": "string", "format": "uuid"},
    "restaurantId": {"type": "string", "format": "uuid"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["productId", "name", "quantity", "unitPriceMinor", "totalMinor"],
        "properties": {
          "productId": {"type": "string", "format": "uuid"},
          "name": {"type": "string"},
          "quantity": {"type": "integer", "minimum": 1},
          "unitPriceMinor": {"type": "integer", "minimum": 0},
          "totalMinor": {"type": "integer", "minimum": 0}
        }
      }
    },
    "deliveryFeeMinor": {"type": "integer", "minimum": 0},
    "totalMinor": {"type": "integer", "minimum": 0},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "status": {"const": "pending"},
    "version": {"type": "integer", "minimum": 1},
    "deliveryAddress": {"type": "string", "minLength": 1},
    "rejectionReason": {"type": ["string", "null"]},
    "statusReasonCode": {"type": ["string", "null"]},
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
