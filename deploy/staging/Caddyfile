{
    admin off
    email {$ACME_EMAIL}
}

{$STAGING_HOST} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
    reverse_proxy web:8080 {
        flush_interval -1
    }
    log {
        output stdout
        format json
    }
}
