@startuml
title C4 Level 2 — Containers
skinparam componentStyle rectangle
skinparam shadowing false

actor "Web-клиент" as web
component "Platform API\nGo, REST" as api
component "Outbox worker\nв процессе Platform API" as worker
database "PostgreSQL\nкаталог, остатки, заказы, outbox" as db
component "Demo Restaurant\nGo, REST" as restaurant

web --> api : Customer API
restaurant --> api : Partner API + API key
api --> db : pgx / SQL
worker --> db : Читает outbox
worker --> restaurant : POST order
restaurant --> api : PATCH order status
@enduml
