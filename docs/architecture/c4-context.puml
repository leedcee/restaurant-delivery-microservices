@startuml
title C4 Level 1 — System Context
skinparam rectangle {
  BackgroundColor #eef5ff
  BorderColor #24527a
}
actor "Пользователь" as user
actor "Сотрудник заведения" as partner
rectangle "Web-клиент\n(вне реализации)" as web
rectangle "Платформа заказа и доставки еды\nGo backend" as platform
rectangle "Система заведения" as restaurant

user --> web : Ищет еду и оформляет заказ
web --> platform : REST/JSON
partner --> restaurant : Управляет меню и заказами
restaurant --> platform : Партнёрский REST API
platform --> restaurant : Передача заказов
@enduml
